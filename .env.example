# copiar a .env y completar; vercel dev lee solo .env

# Credenciales del admin único
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secreto para firmar tokens HMAC (openssl rand -hex 32)
AUTH_SECRET=

# Turso (SQLite serverless)
TURSO_TOKEN=
TURSO_URL=

# Origen permitido para CORS (opcional; en producción usa el dominio de Vercel por defecto)
CORS_ORIGIN=
